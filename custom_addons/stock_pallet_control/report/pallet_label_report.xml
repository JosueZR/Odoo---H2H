<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Papel: etiqueta 4 x 6 pulgadas (102 x 152 mm), vertical -->
    <record id="paperformat_pallet_label" model="report.paperformat">
        <field name="name">Etiqueta de tarima 4x6</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">102</field>
        <field name="page_height">152</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_pallet_label" model="ir.actions.report">
        <field name="name">Etiqueta de tarima (4x6)</field>
        <field name="model">stock.quant.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_pallet_control.report_pallet_label</field>
        <field name="report_file">stock_pallet_control.report_pallet_label</field>
        <field name="paperformat_id" ref="paperformat_pallet_label"/>
        <field name="print_report_name">'Etiqueta tarima - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_quant_package"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_pallet_label">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="quants" t-value="o.quant_ids.filtered(lambda q: q.quantity)"/>
                <t t-set="total_qty" t-value="sum(q.quantity for q in quants)"/>

                <div class="page" style="
                    page-break-after: always;
                    font-family: Arial, Helvetica, sans-serif;
                    color: #1a1a1a;
                    width: 100mm;
                    height: 150mm;
                    margin: 0 auto;
                    box-sizing: border-box;
                    border: 2.5px solid #714B67;
                    border-radius: 5px;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    background-color: #fff;
                    overflow: hidden;
                ">
                    <!-- CABECERA -->
                    <div style="
                        background-color: #714B67;
                        color: #fff;
                        padding: 3.5mm 5mm;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    ">
                        <div style="font-size: 15px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase;">
                            <t t-out="(o.company_id or o.env.company).name"/>
                        </div>
                        <div t-if="o.pallet_total and o.pallet_total > 1" style="
                            background-color: #fff;
                            color: #714B67;
                            font-size: 13px;
                            font-weight: bold;
                            border-radius: 12px;
                            padding: 1.5mm 4.5mm;
                        ">
                            Tarima <t t-out="o.pallet_index"/> / <t t-out="o.pallet_total"/>
                        </div>
                        <div t-else="" style="font-size: 12px; opacity: 0.9; font-weight: bold; letter-spacing: 1px;">
                            TARIMA
                        </div>
                    </div>

                    <!-- CODIGO DE BARRAS CENTRADO Y GRANDE -->
                    <div style="
                        text-align: center;
                        padding: 3.5mm 2mm 2.5mm 2mm;
                        border-bottom: 2px solid #eee;
                    ">
                        <div style="display: inline-block; margin: 0 auto;">
                            <span t-out="o.name"
                                  t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 650, 'height': 180, 'img_style': 'width: 88mm; height: 25mm; margin: 0 auto;'}"/>
                        </div>
                        <div style="font-size: 24px; font-weight: bold; letter-spacing: 5px; margin-top: 1.5mm; color: #714B67;">
                            <t t-out="o.name"/>
                        </div>
                    </div>

                    <!-- DATOS GENERALES -->
                    <div style="padding: 3mm 5mm; border-bottom: 2px solid #eee; background-color: #faf7f9;">
                        <table style="width: 100%; font-size: 13px; border-collapse: collapse;">
                            <tr t-if="o.pallet_origin">
                                <td style="font-weight: bold; color: #714B67; width: 30%; padding: 1.2mm 0; vertical-align: middle;">Referencia</td>
                                <td style="font-size: 13px; font-weight: 500; padding: 1.2mm 0;"><t t-out="o.pallet_origin"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; color: #714B67; padding: 1.2mm 0; vertical-align: middle;">Fecha</td>
                                <td style="padding: 1.2mm 0;"><span t-field="o.pack_date"/></td>
                            </tr>
                            <tr t-if="o.location_id">
                                <td style="font-weight: bold; color: #714B67; padding: 1.2mm 0; vertical-align: middle;">Ubicación</td>
                                <td style="font-size: 15px; font-weight: bold; padding: 1.2mm 0; color: #222;">
                                    <t t-out="o.location_id.display_name"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- CONTENIDO BIEN DISTRIBUIDO -->
                    <div style="padding: 3.5mm 5mm; flex-grow: 1;">
                        <div style="font-weight: bold; font-size: 12px; color: #714B67; margin-bottom: 2.5mm; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1.5px solid #714B67; padding-bottom: 1mm;">
                            Contenido del pallet
                        </div>
                        <table style="width: 100%; font-size: 13px; border-collapse: collapse;">
                            <t t-foreach="quants[:6]" t-as="quant">
                                <tr style="border-bottom: 1px solid #eee;">
                                    <td style="padding: 1.8mm 0; vertical-align: middle;">
                                        <div style="font-weight: bold; font-size: 13px; line-height: 1.2;">
                                            <t t-out="quant.product_id.display_name"/>
                                        </div>
                                        <div t-if="quant.lot_id" style="font-size: 11px; color: #777;">
                                            Lote: <t t-out="quant.lot_id.name"/>
                                        </div>
                                    </td>
                                    <td style="text-align: right; white-space: nowrap; vertical-align: middle; padding-left: 2mm;">
                                        <span style="font-size: 17px; font-weight: bold; color: #111;"><t t-out="'%g' % quant.quantity"/></span>
                                        <span style="font-size: 12px; color: #555;"> <t t-out="quant.product_id.uom_id.name"/></span>
                                    </td>
                                </tr>
                            </t>
                        </table>
                        <div t-if="len(quants) > 6" style="font-size: 11px; color: #888; margin-top: 2mm; font-style: italic;">
                            + <t t-out="len(quants) - 6"/> producto(s) más en este pallet
                        </div>
                    </div>

                    <!-- PIE DE PAGINA -->
                    <div style="
                        background-color: #f3ecf2;
                        border-top: 2px solid #714B67;
                        padding: 3.5mm 5mm;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    ">
                        <t t-set="uoms" t-value="quants.product_id.uom_id"/>
                        <div style="font-size: 13px;">
                            <t t-if="len(uoms) == 1">
                                <span style="font-weight: bold; color: #714B67;">TOTAL: </span>
                                <span style="font-size: 18px; font-weight: bold; color: #111;"><t t-out="'%g' % total_qty"/></span>
                                <span style="font-size: 12px; color: #555;"> <t t-out="uoms.name"/></span>
                            </t>
                        </div>
                        <div t-if="o.package_type_id" style="font-size: 12px; color: #714B67; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">
                            <t t-out="o.package_type_id.name"/>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
