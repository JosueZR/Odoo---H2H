<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pallet_split_form" model="ir.ui.view">
        <field name="name">stock.pallet.split.form</field>
        <field name="model">stock.pallet.split</field>
        <field name="arch" type="xml">
            <form string="Separar en tarimas">
                <field name="picking_id" invisible="1"/>
                <div class="text-muted mb-2">
                    Indica el cliente dueño de la mercancía y cuánto lleva cada tarima. Odoo crea una
                    tarima (paquete) por cada una; después valida la recepción e imprime las etiquetas.
                    Con propietario, la mercancía no suma al valor del inventario.
                </div>
                <group>
                    <field name="owner_id" options="{'no_create': True}"/>
                    <field name="package_type_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="pallet_count"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="true">
                        <field name="tracking" column_invisible="True"/>
                        <field name="move_line_id" column_invisible="True" force_save="1"/>
                        <field name="product_id"/>
                        <field name="lot_name" readonly="tracking != 'lot'" required="tracking == 'lot'"/>
                        <field name="quantity"/>
                        <field name="qty_per_pallet"/>
                        <field name="uom_name"/>
                        <field name="pallet_count" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_split" type="object" string="Crear tarimas"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
