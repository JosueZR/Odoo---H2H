<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="stock_pallet_control.InventoryDashboard">
        <div class="o_wh_dashboard">

            <!-- ── Encabezado ───────────────────────────────────────────── -->
            <div class="o_wh_dashboard_header d-flex justify-content-between align-items-center">
                <div>
                    <div class="o_wh_dashboard_title">
                        <i class="fa fa-cubes me-2"/>
                        Centro de operaciones de almacén
                    </div>
                    <p class="o_wh_dashboard_subtitle">
                        Selecciona una operación para comenzar
                    </p>
                </div>
                <button class="o_wh_btn_fullscreen"
                        t-on-click="toggleFullscreen"
                        type="button"
                        title="Pantalla completa">
                    <i t-attf-class="fa #{state.isFullscreen ? 'fa-compress' : 'fa-expand'} me-1"/>
                    <span t-out="state.isFullscreen ? 'Salir' : 'Pantalla completa'"/>
                </button>
            </div>

            <!-- ── Cuadrícula de tarjetas ────────────────────────────────── -->
            <div class="o_wh_cards_grid">

                <!-- Recibir tarimas (wizard) -->
                <div class="o_wh_card o_wh_card_reception"
                     t-on-click="openRecibirTarimas"
                     role="button" tabindex="0">
                    <div class="o_wh_card_icon_box">
                        <i class="fa fa-truck"/>
                    </div>
                    <div class="o_wh_card_body">
                        <div class="o_wh_card_title">Recibir tarimas</div>
                        <div class="o_wh_card_desc">
                            Registrar entrada de tarimas: crea paquetes, asigna ubicacion e imprime etiquetas
                        </div>
                    </div>
                    <i class="fa fa-chevron-right o_wh_card_arrow"/>
                </div>

                <!-- Ver recepciones (lista) -->
                <div class="o_wh_card o_wh_card_map"
                     t-on-click="openRecepciones"
                     role="button" tabindex="0">
                    <div class="o_wh_card_icon_box">
                        <i class="fa fa-list"/>
                    </div>
                    <div class="o_wh_card_body">
                        <div class="o_wh_card_title">Ver recepciones</div>
                        <div class="o_wh_card_desc">
                            Consultar y gestionar el historial de recepciones de inventario
                        </div>
                    </div>
                    <i class="fa fa-chevron-right o_wh_card_arrow"/>
                </div>

                <!-- Mapa de ubicaciones -->
                <div class="o_wh_card o_wh_card_map"
                     t-on-click="openMapa"
                     role="button" tabindex="0">
                    <div class="o_wh_card_icon_box">
                        <i class="fa fa-map-marker"/>
                    </div>
                    <div class="o_wh_card_body">
                        <div class="o_wh_card_title">Mapa de ubicaciones</div>
                        <div class="o_wh_card_desc">
                            Ver la disponibilidad y ocupación de cada posición del almacén
                        </div>
                    </div>
                    <i class="fa fa-chevron-right o_wh_card_arrow"/>
                </div>

                <!-- Generar ubicaciones -->
                <div class="o_wh_card o_wh_card_generator"
                     t-on-click="openGenerador"
                     role="button" tabindex="0">
                    <div class="o_wh_card_icon_box">
                        <i class="fa fa-plus-square"/>
                    </div>
                    <div class="o_wh_card_body">
                        <div class="o_wh_card_title">Generar ubicaciones</div>
                        <div class="o_wh_card_desc">
                            Crear nuevas ubicaciones y organizar la estructura del almacén
                        </div>
                    </div>
                    <i class="fa fa-chevron-right o_wh_card_arrow"/>
                </div>

                <!-- Salidas -->
                <div class="o_wh_card o_wh_card_outgoing"
                     t-on-click="openSalidas"
                     role="button" tabindex="0">
                    <div class="o_wh_card_icon_box">
                        <i class="fa fa-sign-out"/>
                    </div>
                    <div class="o_wh_card_body">
                        <div class="o_wh_card_title">Salidas</div>
                        <div class="o_wh_card_desc">
                            Registrar salida de tarimas escaneando su codigo de barras
                        </div>
                    </div>
                    <i class="fa fa-chevron-right o_wh_card_arrow"/>
                </div>

                <!-- Movimientos internos -->
                <div class="o_wh_card o_wh_card_internal"
                     t-on-click="openInternos"
                     role="button" tabindex="0">
                    <div class="o_wh_card_icon_box">
                        <i class="fa fa-exchange"/>
                    </div>
                    <div class="o_wh_card_body">
                        <div class="o_wh_card_title">Movimientos internos</div>
                        <div class="o_wh_card_desc">
                            Cambiar la ubicacion de tarimas escaneando origen y destino
                        </div>
                    </div>
                    <i class="fa fa-chevron-right o_wh_card_arrow"/>
                </div>

                <!-- Inventario -->
                <div class="o_wh_card o_wh_card_inventory"
                     t-on-click="openInventario"
                     role="button" tabindex="0">
                    <div class="o_wh_card_icon_box">
                        <i class="fa fa-list-alt"/>
                    </div>
                    <div class="o_wh_card_body">
                        <div class="o_wh_card_title">Inventario</div>
                        <div class="o_wh_card_desc">
                            Consultar existencias, ajustar inventario y revisar conteos físicos
                        </div>
                    </div>
                    <i class="fa fa-chevron-right o_wh_card_arrow"/>
                </div>

            </div><!-- /.o_wh_cards_grid -->
        </div><!-- /.o_wh_dashboard -->
    </t>

</templates>
