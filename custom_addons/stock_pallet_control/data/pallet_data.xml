<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tipo de paquete "Tarima": escanear TARIMA en la app Código de barras pone en tarima -->
        <record id="package_type_tarima" model="stock.package.type">
            <field name="name">Tarima</field>
            <field name="barcode">TARIMA</field>
        </record>

        <!-- Solo al instalar: "Mover paquetes completos" en Entregas e internas de todos los almacenes.
             Si después un responsable lo apaga en algún tipo de operación, una actualización no lo vuelve a prender. -->
        <function model="stock.picking.type" name="_pallet_setup_operation_types"/>
    </data>
</odoo>
