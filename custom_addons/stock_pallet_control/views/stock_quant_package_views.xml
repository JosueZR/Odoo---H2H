<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inventario > Productos > Paquetes (vista nativa): contenido y documento de origen de la tarima -->
    <record id="view_quant_package_tree_pallet" model="ir.ui.view">
        <field name="name">stock.quant.package.list.pallet</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_tree"/>
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="pallet_content" optional="show"/>
                <field name="pallet_origin" optional="show"/>
                <field name="pack_date" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="quant_package_search_view_pallet" model="ir.ui.view">
        <field name="name">stock.quant.package.search.pallet</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.quant_package_search_view"/>
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="pallet_origin"/>
            </field>
        </field>
    </record>
</odoo>
