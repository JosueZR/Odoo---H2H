<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pallet_location_list" model="ir.ui.view">
        <field name="name">stock.location.pallet.list</field>
        <field name="model">stock.location</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Ubicaciones" create="false" delete="false">
                <field name="complete_name" string="Ubicación"/>
                <field name="barcode"/>
                <field name="storage_category_id" optional="show"/>
                <field name="pallet_state" widget="badge"
                       decoration-success="pallet_state == 'free'"
                       decoration-danger="pallet_state == 'occupied'"/>
                <field name="pallet_ids" widget="many2many_tags"/>
                <field name="pallet_owner_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_pallet_location_kanban" model="ir.ui.view">
        <field name="name">stock.location.pallet.kanban</field>
        <field name="model">stock.location</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <kanban create="false" default_group_by="location_id"
                    group_create="false" group_delete="false" group_edit="false"
                    records_draggable="false" class="o_kanban_small_column">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="pallet_state" widget="badge"
                               decoration-success="pallet_state == 'free'"
                               decoration-danger="pallet_state == 'occupied'"/>
                        <field name="pallet_ids" widget="many2many_tags"/>
                        <field name="pallet_owner_ids" widget="many2many_tags"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pallet_location_search" model="ir.ui.view">
        <field name="name">stock.location.pallet.search</field>
        <field name="model">stock.location</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search string="Ubicaciones">
                <field name="complete_name" string="Ubicación"
                       filter_domain="['|', ('complete_name', 'ilike', self), ('barcode', 'ilike', self)]"/>
                <field name="pallet_ids" string="Tarima"/>
                <separator/>
                <filter name="free" string="Libres" domain="[('pallet_state', '=', 'free')]"/>
                <filter name="occupied" string="Ocupadas" domain="[('pallet_state', '=', 'occupied')]"/>
                <separator/>
                <filter name="with_category" string="Con categoría de almacenamiento"
                        domain="[('storage_category_id', '!=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_parent" string="Rack" context="{'group_by': 'location_id'}"/>
                    <filter name="group_category" string="Categoría" context="{'group_by': 'storage_category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pallet_locations" model="ir.actions.act_window">
        <field name="name">Mapa de ubicaciones</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('usage', '=', 'internal')]</field>
        <field name="search_view_id" ref="view_pallet_location_search"/>
        <field name="context">{'search_default_with_category': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_pallet_location_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_pallet_location_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_location_form')})]"/>
    </record>

    <!-- Botón "Tarimas" dentro de la ficha de cada ubicación -->
    <record id="view_location_form_pallets" model="ir.ui.view">
        <field name="name">stock.location.form.pallets</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pallets" type="object" class="oe_stat_button" icon="fa-cubes"
                        invisible="usage != 'internal'">
                    <field name="pallet_count" widget="statinfo" string="Tarimas"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
