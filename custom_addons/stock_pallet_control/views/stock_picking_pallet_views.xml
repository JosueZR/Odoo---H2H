<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hereda el formulario estándar de Recepciones (stock.picking)
        para agregar los campos de gestión por tarima.
        Solo se muestra cuando picking_type_code = 'incoming'.
    -->
    <record id="view_picking_form_pallet_fields" model="ir.ui.view">
        <field name="name">stock.picking.form.pallet.fields</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Boton en la cabecera: visible cuando la recepcion esta validada -->
            <xpath expr="//header" position="inside">
                <button name="action_print_pallet_labels"
                        string="Imprimir etiquetas de tarima"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'done' or picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
