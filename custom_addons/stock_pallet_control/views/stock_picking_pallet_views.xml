<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Recepción estándar (la que genera la orden de compra): separar en tarimas e imprimir etiquetas -->
    <record id="view_picking_form_pallet_fields" model="ir.ui.view">
        <field name="name">stock.picking.form.pallet</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_pallet_split"
                        string="Separar en tarimas"
                        type="object"
                        class="btn-secondary"
                        groups="stock.group_stock_user"
                        invisible="state != 'assigned' or picking_type_code != 'incoming'"/>
                <button name="action_print_pallet_labels"
                        string="Imprimir etiquetas de tarima"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'done' or picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
